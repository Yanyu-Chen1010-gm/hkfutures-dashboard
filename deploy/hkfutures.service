[Unit]
Description=HK Futures Risk & Market Monitor (uvicorn)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/YOUR_USER/hkfutures-dashboard
# Use a non-root user. Set venv python:
ExecStart=/home/YOUR_USER/hkfutures-dashboard/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8031
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
